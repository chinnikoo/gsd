# Copy to .env for local runs (npm run dev). On Render, set these in the dashboard instead.
# MongoDB Atlas connection string: Atlas > your cluster > Connect > Drivers.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=gsd
MONGODB_DB=gsd
# Only used the very first time the database has no users (required when NODE_ENV=production):
# GSD_ADMIN_PASSWORD=
# GSD_STAFF_PASSWORD=
# Seed the VINYL TILES demo items? Defaults to true locally, false in production.
# GSD_SEED_DEMO=false
